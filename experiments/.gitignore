.env
__pycache__/
*.pyc

# runtime volumes — keep the dirs, ignore their contents (large point clouds,
# weights, and SAT staging folders).
data/raw/
data/cache/
data/chunk/
data/models/
data/treelearn/
data/sat/
!data/.gitkeep

# Run outputs stay OUT of git: they are large, binary, and regenerate on every
# run. The directory itself is kept so the compose bind mount has somewhere to
# land. (Supersedes the earlier "result PNGs ARE tracked" rule above.)
results/*
!results/.gitkeep
