.env
__pycache__/
*.pyc

# runtime volumes — keep the dirs, ignore their contents (large point clouds,
# weights, and SAT staging folders).
# Catch-all, not a list: this WAS an enumeration of subfolders, and it silently
# stopped covering the scene once the walker stages started writing
# data/basewalker, data/geowalker and data/tiles — tens of GB of point cloud one
# `git add -A` away from the repo. A catch-all cannot fall behind the pipeline.
data/*
!data/.gitkeep

# Run outputs stay OUT of git. They are large, binary, regenerate on every run,
# and the GPU box hands them over through wormhole rather than the repo. The
# directory itself is kept so the compose bind mount has somewhere to land.
results/*
!results/.gitkeep
