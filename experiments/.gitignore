.env
__pycache__/
*.pyc

# runtime volumes — keep the dirs, ignore their contents (large point clouds,
# weights, and SAT staging folders). Result PNGs under results/ ARE tracked.
data/raw/
data/cache/
data/chunk/
data/models/
data/treelearn/
data/sat/
!data/.gitkeep

# Result images and metrics ARE meant to be committed — that is the only way a
# run on the GPU box gets shared. Negated explicitly rather than just left
# unlisted: a user-level core.excludesFile containing *.png is common on
# Windows, and a repo .gitignore outranks it, so this forces them through.
!results/
!results/**
