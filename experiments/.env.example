# Copy to .env and fill in. `.env` is git-ignored.

# --- Kaggle credentials (to pull the private LiDAR dataset) ---------------
# From https://www.kaggle.com/settings -> "Create New Token" (kaggle.json).
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# --- Source dataset / chunk (optional overrides) --------------------------
KAGGLE_DATASET=samsuperman12/my-private-lidar-dataset
# SOURCE_LAZ_NAME=point_cloud_campus_2025-03-14-12-59-27_result.laz

# The single shared chunk. Center defaults to the cloud centroid if unset.
CHUNK_SIZE=40.0
# CHUNK_CENTER_X=736000.0
# CHUNK_CENTER_Y=4767000.0

# --- SegmentAnyTree image -------------------------------------------------
# Default is compiled for GPU arch sm_60..sm_86. For RTX 40xx / H100 (sm_89/90)
# use the cuda11.8 variant instead:
# SAT_IMAGE=maciekwielgosz/segment-any-tree-cuda11.8.0
SAT_IMAGE=maciekwielgosz/segment-any-tree:latest

# --- Sonata head training (optional) --------------------------------------
# EPOCHS=30
# WHU_MAX_PLY=2

# Which labelled sources train the vegetation head (positive = trees + shrubs).
# Default combines both: WHU-STree (MLS street trees) + Semantic3D (TLS, adds
# real shrub/low-vegetation supervision). Use "whu" alone to skip Semantic3D.
# TRAIN_SOURCES=whu,semantic3d

# --- Semantic3D (only used if 'semantic3d' is in TRAIN_SOURCES) ------------
# Mount pre-downloaded files into experiments/data/raw/semantic3d/ (either the
# .7z archives + sem8_labels_training.7z, or already-extracted .txt + .labels),
# OR set SEM3D_DOWNLOAD=1 to fetch them at runtime. The site's TLS cert is
# mismatched (served as phd-apache.ethz.ch), so downloads use http + unverified
# SSL; mounting the files yourself is more reliable. Files are large (GB each).
# SEM3D_DOWNLOAD=0
# SEM3D_DIR=/data/raw/semantic3d
# SEM3D_STATIONS=bildstein_station1,neugasse_station1,domfountain_station1
# SEM3D_MAX_PTS=6000000       # cap points read per station
# SEM3D_MAX_TILES=16          # cap 30 m tiles taken per station
