# Copy to .env and fill in. `.env` is git-ignored.

# --- Kaggle credentials (to pull the private LiDAR dataset) ---------------
# From https://www.kaggle.com/settings -> "Create New Token" (kaggle.json).
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# --- Source dataset / chunk (optional overrides) --------------------------
KAGGLE_DATASET=samsuperman12/my-private-lidar-dataset
# SOURCE_LAZ_NAME=point_cloud_campus_2025-03-14-12-59-27_result.laz

# The single shared chunk. Center defaults to the cloud centroid if unset.
CHUNK_SIZE=40.0
# CHUNK_CENTER_X=736000.0
# CHUNK_CENTER_Y=4767000.0

# --- SegmentAnyTree image -------------------------------------------------
# Default is compiled for GPU arch sm_60..sm_86. For RTX 40xx / H100 (sm_89/90)
# use the cuda11.8 variant instead:
# SAT_IMAGE=maciekwielgosz/segment-any-tree-cuda11.8.0
SAT_IMAGE=maciekwielgosz/segment-any-tree:latest

# --- Sonata head training (optional) --------------------------------------
# EPOCHS=30
# WHU_MAX_PLY=2

# Which labelled sources train the vegetation head (positive = trees + shrubs).
# Default combines both: WHU-STree (MLS street trees) + Semantic3D (TLS, adds
# real shrub/low-vegetation supervision). Use "whu" alone to skip Semantic3D.
# TRAIN_SOURCES=whu,semantic3d

# --- Semantic3D (only used if 'semantic3d' is in TRAIN_SOURCES) ------------
# Mount pre-downloaded files into experiments/data/raw/semantic3d/ (either the
# .7z archives + sem8_labels_training.7z, or already-extracted .txt + .labels),
# OR set SEM3D_DOWNLOAD=1 to fetch them at runtime. The site's TLS cert is
# mismatched (served as phd-apache.ethz.ch), so downloads use http + unverified
# SSL; mounting the files yourself is more reliable. Files are large (GB each).
# SEM3D_DOWNLOAD=0
# SEM3D_DIR=/data/raw/semantic3d
# SEM3D_STATIONS=bildstein_station1,neugasse_station1,domfountain_station1
# SEM3D_MAX_PTS=6000000       # cap points read per station
# SEM3D_MAX_TILES=16          # cap 30 m tiles taken per station

# --- GeoWalker (through-cloud distance field + the walker on it) ----------
# Everything has a working default; these are the ones worth touching on a new
# machine. Full list in README.md ("Knobs (env)").
#
# Field build (CPU, RAM-bound). Coarsen the voxel or lower GW_MAX_NODES if the
# kNN graph does not fit; the build coarsens itself rather than dying, and says
# so in the log.
# GW_VOXEL=0.25
# GW_MAX_NODES=12e6
# FORCE_GW_FIELD=1        # rebuild an existing field.npz

# Training (GPU). GW_ITERS counts THIS run and is added on top of whatever the
# checkpoint already has; lower GW_BATCH first if you run out of VRAM.
# GW_ITERS=9000
# GW_BATCH=48
# GW_RESUME=0             # start cold instead of resuming the checkpoint

# Throughput (GPU). GW_DETECT_BATCH is the seeds-per-encoder-forward of every
# walk (infer, diagnostics, the head's mining pass, and each training eval). It
# was a hard-coded 256: ~1M points per Sonata pass, which on top of the ~8.5 GB
# the scene store already pins does not leave much of a 16 GB card — and Windows
# spills to host RAM instead of raising. A 59k-seed walk at 256 ran over 24 h
# without finishing; training, at 48, holds its rate. Watch the GPU figure on
# the progress line before raising this.
# GW_DETECT_BATCH=64
# GW_TF32=0               # strict fp32 matmuls (slower, bit-reproducible)
# GW_ENC_AMP=1            # bf16 encoder: ~2x, changes the last digits
# GW_PROGRESS_S=30        # seconds between progress lines; 0 = silent
# GW_PROFILE=1            # add a ball/enc/ctx/dec breakdown to those lines

# Post-walk evidence stage (gw_infer_agg). Nothing here is fitted on the val
# labels — the one weighting knob is explicit, because a fitted one would make
# the threshold sweep that follows choose on data it had already seen.
# GW_AGGREGATE=1           # on; the launcher target sets it for you
# GW_AGG_R=0.5             # vote radius: walkers within this are one pile
# GW_AGG_V0=4              # votes at which a cluster keeps half its score
# GW_AGG_ZQ=25             # z percentile of a pile (a base sits at its bottom)
# GW_AGG_CUT_PCT=2         # height cut = this percentile over labelled bases
# GW_AGG_HEIGHT_R=1.5      # CHM max-pool radius for the lookup

# Tree head (gw_head). The mining walk is the expensive part and is checkpointed
# every GW_HEAD_CHUNK seeds, so an interrupt costs one chunk. The token cache is
# what makes the epochs free; if it does not fit the run says so and falls back.
# GW_HEAD_SEEDS=20000     # thin the walk (hard negatives only; 0 = every seed)
# GW_HEAD_CHUNK=8192
# GW_HEAD_CACHE_GB=6
# GW_HEAD_FORCE=1         # ignore both caches and mine again

# Walker geometry. Changing any of these invalidates an existing checkpoint —
# train.py warns but still fine-tunes, so start cold if you change them.
# GW_SPHERE_R=2.0
# GW_STEPS=8
# GW_MEM=3
# GW_MAX_STEP=1.0
# GW_DEM_PROJECT=0        # 1 = ride the DEM instead of moving freely in 3D

# --- GeoWalker: the attributed survey patch (gw_infer_patch) --------------
# basewalker/poderevka_attributes.csv holds 392 trees with girth and species,
# rows 1..392 of the stem map's base_1 block. gw_infer_patch walks only that
# patch (~1.14 ha, ~2.9k seeds, ~1.6 h) and writes a per-tree answer sheet.
#
# NOTE: the patch is in the TRAINING half of the split, so its score is an
# upper bound, not a held-out estimate. The stage prints this; believe it.
#
# How far outside the surveyed hull still counts as judgeable terrain:
# GW_PATCH_MARGIN=3.0

# --- GeoWalker: the classical control (gw_baseline) -----------------------
# Training-free detection on the same patch, scored by the same matcher, on
# CPU in minutes. Get this number before buying another GPU-hour: it is what
# says whether the walk is earning its cost.
# GW_BASE_METHOD=both        # both | stem | chm
# GW_STEM_LO=1.0             # breast-height slice, m above the DEM
# GW_STEM_HI=3.0
# GW_STEM_CELL=0.10          # plan-view raster
# GW_STEM_MIN_PTS=6          # points in a slice blob to be a candidate
# GW_STEM_SEP=0.6            # minimum separation of two stems, m
# GW_STEM_COL_R=0.35         # verticality column radius, m
# GW_STEM_COL_LO=0.5         # ...spanning this height range
# GW_STEM_COL_HI=8.0
# GW_CHM_MIN_H=              # default: gw_height's derived cut
# GW_CHM_SEP=1.5             # local-maximum window radius, m
